# de docker-compose.yml. Cada app tiene además su propio
# .env.example en apps/api y apps/web.
# ============================================================

# MySQL (debe coincidir con docker-compose.yml)
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=inventory
MYSQL_USER=inventory
MYSQL_PASSWORD=inventory
