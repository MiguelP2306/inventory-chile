# =============================================================================
# Backend (NestJS) — variables de entorno
# =============================================================================
# Copiar a `.env.local` para desarrollo. En Railway pegar cada una en
# "Variables" del servicio (no hace falta archivo).

# ---- Servidor ----
PORT=4000
NODE_ENV=development
# Lista separada por comas. Acepta wildcard básico: https://*.vercel.app
CORS_ORIGIN=http://localhost:3000

# ---- Base de datos (MySQL / TiDB Cloud) ----
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=inventory
DB_PASSWORD=Inv3ntory!
DB_DATABASE=inventory
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_POOL_SIZE=10
# Activar TLS — REQUERIDO en TiDB Cloud y la mayoría de MySQL gestionados.
DB_SSL=false

# ---- JWT ----
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia-este-refresh-secreto
JWT_REFRESH_EXPIRES_IN=7d

# ---- Storage de archivos (Fase 12) ----
# `local` (default): guarda en `apps/api/uploads/<subdir>/`. Dev only — en
# Railway el filesystem es efímero y los archivos se pierden en redeploy.
# `cloudinary`: sube a Cloudinary. Recomendado en producción.
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (Resend) ----
RESEND_API_KEY=
# `onboarding@resend.dev` permite enviar SIN dominio verificado pero solo al
# email dueño de la cuenta Resend (modo dev). Con dominio verificado podés
# poner algo como `cotizaciones@tudominio.cl`.
RESEND_FROM_EMAIL=onboarding@resend.dev
EMAIL_FROM=cotizaciones@onresend.dev

# ---- URLs públicas (para PDFs en emails / WhatsApp / link público de cot) ----
PUBLIC_API_URL=http://localhost:4000
PUBLIC_BASE_URL=http://localhost:3000

# ---- Seed inicial (solo se aplica si el admin aún no existe) ----
SEED_ADMIN_EMAIL=admin@inventory.local
SEED_ADMIN_PASSWORD=admin123

# ---- HubSpot (opcional, Fase 8.5) ----
HUBSPOT_API_KEY=
