{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "assets": [
      {
        "include": "database/seeds/data/*.json",
        "outDir": "dist"
      },
      {
        "include": "assets/*.png",
        "outDir": "dist"
      }
    ],
    "watchAssets": true
  }
}
